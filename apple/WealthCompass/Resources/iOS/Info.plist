<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Wealth Compass Tracker</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<!-- Driven by the build settings, not literals. These were hardcoded, so bumping
	     MARKETING_VERSION / CURRENT_PROJECT_VERSION in project.pbxproj moved what fastlane
	     reports (get_version_number reads the pbxproj) without moving what the binary
	     actually declares - the 1.2.0 release would have uploaded a build still stamped
	     1.1.6 / 22. The macOS target never had this problem: it uses GENERATE_INFOPLIST_FILE. -->
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.finance</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- L01: explicit, auditable App Transport Security stance. All finance API hosts are HTTPS
	     (finnhub.io, api.coingecko.com, api.frankfurter.dev, query1.finance.yahoo.com) and carry the
	     user's API keys, so keep the strict default: no arbitrary loads, no per-domain exceptions
	     (an exception would merely restate the secure default and could weaken it as providers move
	     to TLS 1.3-only). Do NOT add NSAllowsArbitraryLoads or NSExceptionDomains without security review. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<false/>
	</dict>
	<key>NSFaceIDUsageDescription</key>
	<string>Use Face ID to unlock your local Wealth Compass Tracker data.</string>
	<!-- Single-window, deliberately. The Mac app is already effectively single-window — its
	     CommandGroup(replacing: .newItem) rebinds Cmd-N to New Transaction, so it offers no New
	     Window — and the iPad runs that same UI. It also avoids a real defect: ContentView and
	     MacRootView both drive appLock.lock() from scenePhase, and with two scenes, sending one
	     window to the background would lock the window the user is still reading. Split View and
	     Slide Over alongside OTHER apps are unaffected by this key. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict/>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- M31: wake the app on a silent CloudKit push to fetch remote changes in the background
	     (paired with the aps-environment entitlement + registerForRemoteNotifications). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!-- The launch screen renders before any SwiftUI runs, so it cannot see the app's own
	     `.preferredColorScheme(.dark)`; with no style pinned it followed the *system* appearance
	     and a cold launch on a light-mode device flashed white into a dark-only app. -->
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<key>UILaunchScreen</key>
	<dict/>
	<!-- iPhone stays portrait-only: its TabView layout was designed for one orientation. iPad
	     takes all four, because landscape is the ordinary way to hold one — and the sidebar UI it
	     runs was built for a landscape-shaped Mac window in the first place. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
